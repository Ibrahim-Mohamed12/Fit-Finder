@{
    ViewBag.Title = "Admin Dashboard";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="flex h-screen">

    <aside id="sidebar" class="DashShadow fixed md:static top-0 left-0 h-full w-80 bg-black md:bg-linear-to-br from-gray-900/20 to-gray-900/30 -translate-x-full md:translate-x-0 transition duration-300 flex flex-col z-50">

        <!-- Logo -->
        <div class="flex items-center justify-between p-4 border-primary">

            <img class="w-25 h-auto sidebar-text" src="../Images/White_Logo.png">

            <button onclick="toggleSidebar()" class="hover:bg-gray-800 p-2 rounded h-14 cursor-pointer">
                <span class="material-symbols-outlined Icons">menu</span>
            </button>

        </div>

        <!-- Menu -->
        <nav class="flex flex-col gap-3 p-3 text-xl font-primary tracking-wider font-thin flex-1">

            <a asp-controller="Admin" asp-action="AdminDashboard" class="flex items-center gap-5 p-3 hover:bg-gray-800 bg-zinc-400/30 rounded cursor-pointer">
                <span class="material-symbols-outlined Icons">dashboard</span>
                <span class="sidebar-text text-2xl">Dashboard</span>
            </a>

            <a asp-controller="Admin" asp-action="AdminGyms" class="flex items-center gap-5 p-3 hover:bg-gray-800 rounded cursor-pointer">
                <span class="material-symbols-outlined Icons">fitness_center</span>
                <span class="sidebar-text text-2xl">Gyms</span>
            </a>

            <a asp-controller="Admin" asp-action="AdminSubscriptions" class="flex items-center gap-5 p-3 hover:bg-gray-800 rounded cursor-pointer">
                <span class="material-symbols-outlined Icons">workspace_premium</span>
                <span class="sidebar-text text-2xl">Subscriptions</span>
            </a>

            <a asp-controller="Admin" asp-action="AdminPayments" class="flex items-center gap-5 p-3 hover:bg-gray-800 rounded cursor-pointer">
                <span class="material-symbols-outlined Icons">payments</span>
                <span class="sidebar-text text-2xl">Payments</span>
            </a>

            <a asp-controller="Admin" asp-action="AdminUsers" class="flex items-center gap-5 p-3 hover:bg-gray-800 rounded cursor-pointer">
                <span class="material-symbols-outlined Icons">group</span>
                <span class="sidebar-text text-2xl">Users</span>
            </a>

            <a asp-controller="Admin" asp-action="AdminMessages" class="flex items-center gap-5 p-3 hover:bg-gray-800 rounded cursor-pointer">
                <span class="material-symbols-outlined Icons">mail</span>
                <span class="sidebar-text text-2xl">Messages</span>
            </a>

            <!-- Logout -->
            <div class="mt-auto text-xl font-primary tracking-wider">

                <a asp-controller="Home" asp-action="logout" class="w-full flex items-center gap-5 p-3 font-thin text-white rounded hover:bg-gray-800 transition cursor-pointer bg-gray-100/4">

                    <span class="material-symbols-outlined Icons">logout</span>
                    <span class="sidebar-text text-2xl">Logout</span>

                </a>

            </div>

        </nav>

