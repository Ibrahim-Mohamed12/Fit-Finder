                            <div class="text-md border-primary/70 flex cursor-pointer items-center gap-2 rounded-md border px-8 py-2 text-gray-300 transition hover:bg-primary hover:text-black">
                                <span class="material-symbols-outlined cursor-pointer">group</span>
                                <button class="cursor-pointer">
                                    All
