                    <!-- TITLE -->
                    <h2 class="text-5xl sm:text-6xl md:text-7xl font-medium font-primary text-white mb-4">
                        Members <span class="text-primary"></span>
                    </h2>

                    <p class="text-base sm:text-lg md:text-xl font-light text-gray-300 tracking-wide mb-8">
                        Manage and monitor gym members across all branches
