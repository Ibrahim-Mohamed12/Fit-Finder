                    <!-- TITLE -->
                    <h2 class="font-primary mb-4 text-5xl font-medium text-white sm:text-6xl md:text-7xl">
                        Members <span class="text-primary"></span>
                    </h2>

                    <p class="mb-8 text-base font-light tracking-wide text-gray-300 sm:text-lg md:text-xl">
