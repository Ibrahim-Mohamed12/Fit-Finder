                            <input type="text" placeholder="Search gyms..." class="w-full bg-black/70 text-base md:text-lg border border-primary/40 focus:border-primary text-white placeholder-gray-400 pl-5 pr-12 py-4 rounded-xl outline-none transition"/>

                            <!-- ICON -->
                            <span class="absolute right-4 top-1/2 -translate-y-1/2 text-gray-400">
                                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 md:h-6 md:w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                                </svg>
                            </span>

                        </div>

                        <!-- FILTERS -->
