                            <div class="flex items-center px-8 py-2 gap-2 text-md rounded-md border border-primary/70 text-gray-300 hover:bg-primary hover:text-black cursor-pointer transition">
                                <span class="material-symbols-outlined cursor-pointer">group</span>
                                <button class="cursor-pointer">
                                    All
                                </button>
                            </div>

                            <div class="flex items-center px-8 py-2 gap-2 text-md rounded-md border border-primary/70 text-gray-300 hover:bg-primary hover:text-black cursor-pointer transition">
