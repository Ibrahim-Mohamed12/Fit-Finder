@{
    ViewBag.Title = "Admin Dashboard";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="flex h-screen">

    <aside id="sidebar" class="DashShadow fixed top-0 left-0 z-50 flex h-full w-80 -translate-x-full flex-col bg-black from-gray-900/20 to-gray-900/30 transition duration-300 md:static md:translate-x-0 md:bg-linear-to-br">

        <!-- Logo -->
        <div class="border-primary flex items-center justify-between p-4">

            <img class="sidebar-text h-auto w-25" src="../Images/White_Logo.png">

            <button onclick="toggleSidebar()" class="h-14 cursor-pointer rounded p-2 hover:bg-gray-800">
                <span class="material-symbols-outlined Icons">menu</span>
            </button>

        </div>

        <!-- Menu -->
        <nav class="font-primary flex flex-1 flex-col gap-3 p-3 text-xl font-thin tracking-wider">

            <a asp-controller="Admin" asp-action="AdminDashboard" class="flex cursor-pointer items-center gap-5 rounded p-3 hover:bg-gray-800">
                <span class="material-symbols-outlined Icons">dashboard</span>
                <span class="sidebar-text text-2xl">Dashboard</span>
            </a>

            <a asp-controller="Admin" asp-action="AdminGyms" class="flex cursor-pointer items-center gap-5 rounded p-3 hover:bg-gray-800">
                <span class="material-symbols-outlined Icons">fitness_center</span>
                <span class="sidebar-text text-2xl">Gyms</span>
            </a>

            <a asp-controller="Admin" asp-action="AdminSubscriptions" class="flex cursor-pointer items-center gap-5 rounded p-3 hover:bg-gray-800">
                <span class="material-symbols-outlined Icons">workspace_premium</span>
                <span class="sidebar-text text-2xl">Subscriptions</span>
            </a>

            <a asp-controller="Admin" asp-action="AdminPayments" class="flex cursor-pointer items-center gap-5 rounded p-3 hover:bg-gray-800">
                <span class="material-symbols-outlined Icons">payments</span>
                <span class="sidebar-text text-2xl">Payments</span>
            </a>

            <a asp-controller="Admin" asp-action="AdminUsers" class="flex cursor-pointer items-center gap-5 rounded p-3 hover:bg-gray-800">
                <span class="material-symbols-outlined Icons">group</span>
                <span class="sidebar-text text-2xl">Users</span>
            </a>

            <a asp-controller="Admin" asp-action="AdminMessages" class="flex cursor-pointer items-center gap-5 rounded bg-zinc-400/30 p-3 hover:bg-gray-800">
                <span class="material-symbols-outlined Icons">mail</span>
                <span class="sidebar-text text-2xl">Messages</span>
            </a>

            <!-- Logout -->
            <div class="font-primary mt-auto text-xl tracking-wider">

                <button class="flex w-full cursor-pointer items-center gap-5 rounded bg-gray-100/4 p-3 font-thin text-white transition hover:bg-gray-800">

                    <span class="material-symbols-outlined Icons">logout</span>
                    <span class="sidebar-text text-2xl">Logout</span>

                </button>

            </div>

        </nav>

    </aside>

    <div id="overlay" class="fixed inset-0 z-40 hidden bg-black/60 md:hidden"></div>

    <!-- ================= MAIN ================= -->
    <div class="flex flex-1 flex-col bg-linear-to-br from-gray-900/20 to-gray-900/30">

        <header class="flex items-center justify-between border-b border-gray-800 bg-linear-to-br from-gray-900/10 to-gray-900/5 p-6 text-white">

            <!-- MOBILE MENU -->
            <button onclick="toggleSidebar()" class="cursor-pointer md:hidden">
                <span class="material-symbols-outlined Icons">menu</span>
            </button>

            <h1 class="font-primary text-3xl font-medium tracking-wide">
                Admin Dashboard
            </h1>

            <div class="flex items-center gap-4">
                <span class="material-symbols-outlined Icons cursor-pointer transition hover:text-primary">notifications</span>
                <img src="https://i.pravatar.cc/40" class="cursor-pointer rounded-full border-2 border-white" alt="Profile">
            </div>

        </header>

        <!-- CONTENT -->
        <main class="space-y-10 overflow-y-auto p-6">

            <div class="fade-up px-6 py-10 lg:px-20">

                <!-- ===== CONTACT MESSAGES STATS ===== -->
                <div class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3">

                    <div class="CardShadow rounded-2xl bg-linear-to-br from-gray-900/20 to-gray-900/40 p-6 text-start transition hover:scale-[1.03]">
                        <div class="flex items-center justify-between">
                            <p class="text-sm text-gray-300">Total Messages</p>
                            <span class="material-symbols-outlined text-blue-400">mail</span>
                        </div>
                        <h2 class="mt-3 text-2xl font-bold">128</h2>
                        <p class="text-xs text-gray-400">All received messages</p>
                    </div>

                    <div class="CardShadow rounded-2xl bg-linear-to-br from-gray-900/20 to-gray-900/40 p-6 text-start transition hover:scale-[1.03]">
                        <div class="flex items-center justify-between">
                            <p class="text-sm text-gray-300">Unread</p>
                            <span class="material-symbols-outlined text-red-400">mark_email_unread</span>
                        </div>
                        <h2 class="mt-3 text-2xl font-bold">24</h2>
                        <p class="text-xs text-gray-400">Pending review</p>
                    </div>

                    <div class="CardShadow rounded-2xl bg-linear-to-br from-gray-900/20 to-gray-900/40 p-6 text-start transition hover:scale-[1.03]">
                        <div class="flex items-center justify-between">
                            <p class="text-sm text-gray-300">Responded</p>
                            <span class="material-symbols-outlined text-green-400">mark_email_read</span>
                        </div>
                        <h2 class="mt-3 text-2xl font-bold">104</h2>
                        <p class="text-xs text-gray-400">Handled messages</p>
                    </div>

                </div>

                <!-- TITLE -->
                <h2 class="font-primary mt-20 mb-4 text-center text-5xl font-medium sm:text-6xl md:text-7xl">
                    Contact <span class="text-primary">Messages</span>
                </h2>

                <p class="mb-15 text-center text-base text-gray-300 sm:text-lg">
                    Manage messages sent by users through the contact form
                </p>


            <!-- ===== MESSAGES LIST ===== -->
            <div class="space-y-4">

                <!-- MESSAGE CARD -->
                <div class="flex flex-col gap-4 rounded-2xl bg-gray-800/30 p-5 transition hover:bg-gray-800/40 md:items-center xl:flex-row">

                    <!-- LEFT -->
                    <div class="flex-1 gap-2 text-center xl:text-start">
                        <p class="font-semibold text-white">Ahmed Ali</p>
                        <p class="text-sm text-gray-400">ahmed@email.com</p>
                        <span class="text-xs text-gray-500">Today • 2:45 PM</span>
                    </div>

                    <!-- MIDDLE (MESSAGE) -->
                    <div class="flex-2 rounded-xl bg-gray-900/40 p-4">
                        <p class="text-lg leading-relaxed text-gray-200">
                            I want to know more about subscription plans and pricing details. Also I would like to know if there are any discounts for yearly subscriptions.
                        </p>
                    </div>

                    <!-- RIGHT -->
                    <div class="flex flex-1 items-center justify-center gap-3 md:justify-end">

                        <span class="rounded-full bg-red-100 px-3 py-1 text-xs text-red-600">
                            New
                        </span>

                        <button class="flex items-center gap-1 rounded-lg bg-red-600 px-3 py-2 text-sm text-white transition hover:bg-red-500">
                            <span class="material-symbols-outlined text-sm">delete</span>
                            Delete
                        </button>

                    </div>

                </div>

                    <!-- MESSAGE CARD -->
                    <div class="flex flex-col gap-4 rounded-2xl bg-gray-800/30 p-5 transition hover:bg-gray-800/40 md:items-center xl:flex-row">

                        <div class="flex-1 gap-2 text-center xl:text-start">
                            <p class="font-semibold text-white">Sara Mohamed</p>
                            <p class="text-sm text-gray-400">sara@email.com</p>
                            <span class="text-xs text-gray-500">Yesterday • 6:10 PM</span>
                        </div>

                        <div class="flex-2 rounded-xl bg-gray-900/40 p-4">
                            <p class="text-lg leading-relaxed text-gray-200">
                                The app is great but I’m facing an issue with payments confirmation. Can you please check my last transaction?
                            </p>
                        </div>

                        <div class="flex flex-1 items-center justify-center gap-3 md:justify-end">

                            <span class="rounded-full bg-yellow-100 px-3 py-1 text-xs text-yellow-700">
                                Pending
                            </span>

                            <button class="flex items-center gap-1 rounded-lg bg-red-600 px-3 py-2 text-sm text-white transition hover:bg-red-500">
                                <span class="material-symbols-outlined text-sm">delete</span>
                                Delete
                            </button>

                        </div>

                    </div>

                    </div>

                </div>

        </main>
    </div>
</div>
