@{
    ViewBag.Title = "Owner Dashboard";
    Layout = "~/Views/Shared/_OwnerLayout.cshtml";
}

<div class="flex h-screen">

    <!-- Sidebar -->
    <aside id="sidebar" class="DashShadow fixed top-0 left-0 z-50 flex h-full w-80 -translate-x-full flex-col bg-black from-gray-900/20 to-gray-900/30 transition duration-300 md:static md:translate-x-0 md:bg-linear-to-br">
        <!-- Logo -->
        <div class="border-primary flex items-center justify-between p-4">

            <img class="sidebar-text h-auto w-25" src="../Images/White_Logo.png">

            <button onclick="toggleSidebar()" class="h-14 cursor-pointer rounded p-2 hover:bg-gray-800"><span class="material-symbols-outlined Icons">menu</span></button>

        </div>

        <!-- Menu -->
        <nav class="font-primary flex flex-1 flex-col gap-3 p-3 text-xl font-thin tracking-wider">
            <a asp-controller="Owner" asp-action="OwnerDashboard" class="flex cursor-pointer items-center gap-5 rounded p-3 hover:bg-gray-800">

                <span class="material-symbols-outlined Icons">dashboard</span>
                <span class="sidebar-text text-2xl">Dashboard</span>

            </a>

            <a asp-controller="Owner" asp-action="MyGyms" class="flex cursor-pointer items-center gap-5 rounded p-3 hover:bg-gray-800">

                <span class="material-symbols-outlined Icons">fitness_center</span>
                <span class="sidebar-text text-2xl">My Gyms</span>

            </a>

            <a asp-controller="Owner" asp-action="Plans" class="flex cursor-pointer items-center gap-5 rounded bg-zinc-400/30 p-3 hover:bg-gray-800">

                <span class="material-symbols-outlined Icons">workspace_premium</span>
                <span class="sidebar-text text-2xl">Plans</span>

            </a>

            <a asp-controller="Owner" asp-action="Earnings" class="flex cursor-pointer items-center gap-5 rounded p-3 hover:bg-gray-800">

                <span class="material-symbols-outlined Icons">payments</span>
                <span class="sidebar-text text-2xl">Earnings</span>

            </a>

            <a asp-controller="Owner" asp-action="Members" class="flex cursor-pointer items-center gap-5 rounded p-3 hover:bg-gray-800">

                <span class="material-symbols-outlined Icons">group</span>
                <span class="sidebar-text text-2xl">Members</span>

            </a>

            <a asp-controller="Owner" asp-action="ContactUs" class="flex cursor-pointer items-center gap-5 rounded p-3 hover:bg-gray-800">

                <span class="material-symbols-outlined Icons">phone</span>
                <span class="sidebar-text text-2xl">Contact US</span>

            </a>

            <!-- Logout -->
            <div class="font-primary mt-auto text-xl tracking-wider">

                <button class="flex w-full cursor-pointer items-center gap-5 rounded bg-gray-100/4 p-3 font-thin text-white transition hover:bg-gray-800">

                    <span class="material-symbols-outlined Icons">logout</span>
                    <span class="sidebar-text text-2xl">Logout</span>

                </button>

            </div>

        </nav>

    </aside>

    <div id="overlay" class="fixed inset-0 z-40 hidden bg-black/60 md:hidden"></div>

    <!-- ================= MAIN ================= -->
    <div class="flex flex-1 flex-col bg-linear-to-br from-gray-900/20 to-gray-900/30">

        <header class="flex items-center justify-between border-b border-gray-800 bg-linear-to-br from-gray-900/10 to-gray-900/5 p-6 text-white">

            <!-- MOBILE MENU -->
            <button onclick="toggleSidebar()" class="cursor-pointer md:hidden">
                <span class="material-symbols-outlined Icons">menu</span>
            </button>

            <h1 class="font-primary text-3xl font-medium tracking-wide">
                Gym Owner Dashboard
            </h1>

            <div class="flex items-center gap-4">
                <span class="material-symbols-outlined Icons cursor-pointer transition hover:text-primary">notifications</span>
                <img src="https://i.pravatar.cc/40" class="cursor-pointer rounded-full border-2 border-white" alt="Profile">
            </div>

        </header>

        <!-- CONTENT -->
        <main class="space-y-10 overflow-y-auto">

            <!-- ================= STATS ================= -->
            <section class="space-y-6">

                <!-- ===== STATS ===== -->
                <div class="mx-20 mt-10 grid grid-cols-1 gap-5 text-center lg:grid-cols-4">

                    <!-- Card -->
                    <div class="CardShadow cursor-pointer rounded-2xl bg-linear-to-br from-gray-900/20 to-gray-900/40 p-6 text-start transition hover:scale-[1.03]">
                        <div class="flex items-center justify-between">
                            <p class="text-sm text-gray-300">Total Plans</p>
                            <span class="material-symbols-outlined text-xl text-yellow-400">fitness_center</span>
                        </div>
                        <h2 class="mt-3 text-2xl font-bold">6</h2>
                        <p class="mt-1 text-xs text-gray-400">Total plans available</p>
                    </div>

                    <div class="CardShadow cursor-pointer rounded-2xl bg-linear-to-br from-gray-900/20 to-gray-900/40 p-6 text-start transition hover:scale-[1.03]">
                        <div class="flex items-center justify-between">
                            <p class="text-sm text-gray-300">Total Subscribers</p>
                            <span class="material-symbols-outlined text-xl text-red-400">subscriptions</span>
                        </div>
                        <h2 class="mt-3 text-2xl font-bold">6</h2>
                        <p class="mt-1 text-xs text-gray-400">Total subscribers across all gyms</p>
                    </div>

                    <div class="CardShadow cursor-pointer rounded-2xl bg-linear-to-br from-gray-900/20 to-gray-900/40 p-6 text-start transition hover:scale-[1.03]">
                        <div class="flex items-center justify-between">
                            <p class="text-sm text-gray-300">This Month</p>
                            <span class="material-symbols-outlined text-xl text-blue-400">calendar_month</span>
                        </div>
                        <h2 class="mt-3 text-2xl font-bold">$3200</h2>
                        <p class="mt-1 text-xs text-gray-400">Total earnings this month</p>
                    </div>

                    <div class="CardShadow cursor-pointer rounded-2xl bg-linear-to-br from-gray-900/20 to-gray-900/40 p-6 text-start transition hover:scale-[1.03]">
                        <div class="flex items-center justify-between">
                            <p class="text-sm text-gray-300">Active Plans</p>
                            <span class="material-symbols-outlined text-xl text-green-400">check_circle</span>
                        </div>
                        <h2 class="mt-3 text-2xl font-bold">3</h2>
                        <p class="mt-1 text-xs text-gray-400">Total active plans</p>
                    </div>

                </div>

            </section>
            <!-- ================= PLANS ================= -->
            <section class="mx-auto space-y-6 px-6 lg:px-20">

                <!-- ===== HEADER ===== -->
                <div class="mt-20 mb-8 flex flex-col items-center">

                    <div class="fade-up mb-12 text-center">
                        <h2 class="font-primary mb-4 text-4xl font-medium text-white sm:text-5xl md:text-6xl">
                            Membership<span class="text-primary"> Plans</span>
                        </h2>
                        <p class="text-base font-light tracking-wide text-gray-300 sm:text-md md:text-lg">
                            Manage subscription packages for your gyms
                        </p>
                    </div>

                    <div class="mb-10 w-full md:max-w-2xl">

                        <button class="bg-primary font-primary flex w-full items-center justify-center gap-2 rounded-xl px-8 py-3 text-xl font-medium text-black transition hover:scale-[1.02] hover:opacity-90 md:text-2xl xl:max-w-2xl">
                            <span class="material-symbols-outlined text-2xl">add</span>Add New Plan
                        </button>

                    </div>

                </div>

                <!-- ===== TABLE ===== -->
                <div class="border-primary/20 overflow-x-auto rounded-2xl border bg-black/60">

                    <table class="min-w-full text-center text-sm">

                        <!-- HEAD -->
                        <thead class="bg-black/80 tracking-wider text-gray-400 text-[11px] uppercase">
                            <tr>
                                <th class="p-4 text-left">Plan</th>
                                <th class="p-4">Price</th>
                                <th class="p-4">Features</th>
                                <th class="p-4">Subscribers</th>
                                <th class="p-4">Revenue</th>
                                <th class="p-4">Status</th>
                                <th class="p-4 text-right">Actions</th>
                            </tr>
                        </thead>

                        <!-- BODY -->
                        <tbody class="divide-y divide-gray-800">

                            <!-- BASIC -->
                            <tr class="transition duration-200 hover:bg-white/5">

                                <!-- PLAN -->
                                <td class="p-4 text-left">
                                    <p class="font-medium text-white">Basic</p>
                                    <p class="text-xs text-gray-500">Starter plan</p>
                                </td>

                                <!-- PRICE -->
                                <td class="p-4">
                                    <span class="text-primary font-semibold">$25</span>
                                    <span class="text-xs text-gray-500">/mo</span>
                                </td>

                                <!-- FEATURES -->
                                <td class="p-4 text-xs leading-relaxed text-gray-400">
                                    Gym • Locker • 2 classes/week
                                </td>

                                <!-- SUBS -->
                                <td class="p-4 font-medium text-white">42</td>

                                <!-- REVENUE -->
                                <td class="p-4 font-medium text-green-400">$1,050</td>

                                <!-- STATUS -->
                                <td class="p-4">
                                    <span class="rounded-full bg-green-500/10 px-3 py-1 text-xs text-green-400">
                                        Active
                                    </span>
                                </td>

                                <!-- ACTIONS -->
                                <td class="p-4">
                                    <div class="flex justify-end gap-2">
                                        <button class="bg-primary rounded-md px-3 py-1 text-xs text-black hover:opacity-90">
                                            Edit
                                        </button>
                                        <button class="rounded-md border border-red-500 px-3 py-1 text-xs text-red-400 hover:bg-red-500/10">
                                            Disable
                                        </button>
                                    </div>
                                </td>

                            </tr>

                            <!-- PREMIUM -->
                            <tr class="transition duration-200 hover:bg-white/5">

                                <td class="p-4 text-left">
                                    <p class="font-medium text-white">Premium</p>
                                    <p class="text-xs text-gray-500">Most popular</p>
                                </td>

                                <td class="p-4">
                                    <span class="text-primary font-semibold">$50</span>
                                    <span class="text-xs text-gray-500">/mo</span>
                                </td>

                                <td class="p-4 text-xs leading-relaxed text-gray-400">
                                    24/7 • Trainer • Unlimited classes
                                </td>

                                <td class="p-4 font-medium text-white">71</td>

                                <td class="p-4 font-medium text-green-400">$3,550</td>

                                <td class="p-4">
                                    <span class="rounded-full bg-yellow-500/10 px-3 py-1 text-xs text-yellow-400">
                                        Popular
                                    </span>
                                </td>

                                <td class="p-4">
                                    <div class="flex justify-end gap-2">
                                        <button class="bg-primary rounded-md px-3 py-1 text-xs text-black hover:opacity-90">
                                            Edit
                                        </button>
                                        <button class="rounded-md border border-red-500 px-3 py-1 text-xs text-red-400 hover:bg-red-500/10">
                                            Disable
                                        </button>
                                    </div>
                                </td>

                            </tr>

                            <!-- VIP -->
                            <tr class="transition duration-200 hover:bg-white/5">

                                <td class="p-4 text-left">
                                    <p class="font-medium text-white">VIP</p>
                                    <p class="text-xs text-gray-500">Exclusive plan</p>
                                </td>

                                <td class="p-4">
                                    <span class="text-primary font-semibold">$80</span>
                                    <span class="text-xs text-gray-500">/mo</span>
                                </td>

                                <td class="p-4 text-xs leading-relaxed text-gray-400">
                                    All + Private coach • Sauna
                                </td>

                                <td class="p-4 font-medium text-white">19</td>

                                <td class="p-4 font-medium text-green-400">$1,520</td>

                                <td class="p-4">
                                    <span class="rounded-full bg-purple-500/10 px-3 py-1 text-xs text-purple-400">
                                        Exclusive
                                    </span>
                                </td>

                                <td class="p-4">
                                    <div class="flex justify-end gap-2">
                                        <button class="bg-primary rounded-md px-3 py-1 text-xs text-black hover:opacity-90">
                                            Edit
                                        </button>
                                        <button class="rounded-md border border-red-500 px-3 py-1 text-xs text-red-400 hover:bg-red-500/10">
                                            Disable
                                        </button>
                                    </div>
                                </td>

                            </tr>

                        </tbody>

                    </table>

                </div>

            </section>

        </main>
    </div>
</div>