<!DOCTYPE html>

<html>
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined" />
    <link href="./css/output.css" rel="stylesheet">
</head>
<body>

    <!-- Navigation Bar -->
    <nav id="mainNav" class="Nav-style">

        <img src="Images/White_Logo.png" alt="Logo" class="h-10 w-auto relative bottom-1 transition-transform duration-300 transform hover:scale-110 cursor-pointer">

        <!-- Hamburger for small screens -->
        <div class="lg:hidden">
            <button id="burgerBtn" class="focus:outline-none cursor-pointer transition-transform duration-300 transform hover:scale-110">
                <svg class="h-8 w-8 text-white" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                          d="M4 6h16M4 12h16M4 18h16" />
                </svg>
            </button>
        </div>

        <ul id="navLinks" class="hidden lg:flex lg:space-x-10 lg:flex-row md:flex-row sm:flex-col sm:gap-6 sm:items-center">
            <li><a href="#mainBody" class="font-primary Nav-link">Home</a></li>
            <li><a href="#services" class="font-primary Nav-link">Services</a></li>
            <li><a href="#about" class="font-primary Nav-link">About</a></li>
            <li><a href="#contact" class="font-primary Nav-link">Contact</a></li>
        </ul>
        <ul id="ctaLinks" class="hidden lg:flex justify-center items-center space-x-4">

            <li><a asp-controller="Home" asp-action="role" class="font-primary hover:text-primary hover:bg-gray-600/80 text-2xl rounded-sm py-2 px-4 bg-primary text-black">Start now</a></li>
        </ul>
    </nav>

    @RenderBody()

    <footer class="w-full h-fit bg-black/90 py-6 text-center text-gray-400 text-sm">
        <div class="flex flex-col justify-center gap-12 relative">
            <img src="./Images/White_Logo.png" alt="FitFinder Logo" class="h-18 w-auto mx-auto mb-2">

            <ul class="flex justify-center items-center gap-6 mb-16 lg:space-x-10 lg:flex-row md:flex-row flex-col sm:gap-6 sm:items-center after:content-[''] after:absolute after:w-full after:h-px after:bg-gray-500/90 after:bottom-0 after:left-0 after:mb-6">
                <li><a href="#mainBody" class="font-primary Nav-link">Home</a></li>
                <li><a href="#services" class="font-primary Nav-link">Services</a></li>
                <li><a href="#about" class="font-primary Nav-link">About</a></li>
                <li><a href="#contact" class="font-primary Nav-link">Contact</a></li>
                <a asp-controller="Home" asp-action="role" class="font-primary hover:text-primary hover:bg-gray-600/80 text-2xl rounded-sm py-2 px-4 bg-primary text-black">Start now</a>
            </ul>
        </div>
        &copy; 2026 FitFinder. All rights reserved.
    </footer>

    <a id="backToTopFixed" href="#mainBody">
        <div class="BackToTop fixed bottom-5 right-5 text-black bg-primary p-4 rounded-md shadow-lg hover:bg-yellow-600 cursor-pointer">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 10l7-7m0 0l7 7m-7-7v18" />
            </svg>
        </div>
    </a>

    <script src="Js/index.js"></script>
</body>
</html>
