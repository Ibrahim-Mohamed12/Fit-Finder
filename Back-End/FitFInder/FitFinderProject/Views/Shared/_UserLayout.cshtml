<!DOCTYPE html>

<html>
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title</title>
    <link rel="icon" sizes="96x96" href="~/images/favicon-96x96.png">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Betania+Patmos&family=Fjalla+One&family=Outfit:wght@100..900&family=Quicksand:wght@300..700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined" />
    <link rel="stylesheet" href="~/css/output.css" asp-append-version="true" />
</head>
<body class="relative">

    <!-- Navigation Bar -->
    <nav id="mainNav" class="User-Nav-style">
        <div class="flex justify-start">
            <img src="../Images/White_Logo.png" alt="Logo"
                 class="h-10 w-auto cursor-pointer transition-transform duration-300 hover:scale-110">
        </div>
        <!-- Hamburger for small screens -->
        <div class="ml-auto lg:hidden">
            <button id="burgerBtn"
                    class="cursor-pointer transition-transform duration-300 hover:scale-110 focus:outline-none">
                <svg class="h-8 w-8 text-white" xmlns="http://www.w3.org/2000/svg" fill="none"
                     viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                          d="M4 6h16M4 12h16M4 18h16" />
                </svg>
            </button>
        </div>

        <ul id="navLinks" class="hidden justify-center space-x-10 lg:flex">
            <li><a asp-controller="User" asp-action="UserHome" class="font-primary Nav-link">Home</a></li>
            <li><a asp-controller="User" asp-action="Gyms" class="font-primary Nav-link">Gyms</a></li>
            <li><a asp-controller="User" asp-action="Subscription" class="font-primary Nav-link">Subscriptions</a></li>
            <li><a asp-controller="User" asp-action="Payments" class="font-primary Nav-link">Payments</a></li>
            <li><a asp-controller="User" asp-action="Contacts" class="font-primary Nav-link">Contact us</a></li>
        </ul>
        <ul id="ctaLinks" class="hidden items-center justify-end space-x-4 lg:flex">
            <li>
                <a href="profile.html">
                    <div class="flex cursor-pointer items-center transition duration-300 hover:scale-110">
                        <img src="../Images/Profile.jpg" class="h-10 w-10 rounded-full object-cover">
                    </div>
                </a>
            </li>
            <li>
                <a asp-controller="Home" asp-action="logout" class="font-primary bg-primary rounded-sm px-4 py-2 text-2xl text-black hover:text-primary hover:bg-gray-600/80">
                    Logout
                </a>
            </li>
        </ul>

        <!-- Mobile Menu -->
        <div id="mobileMenu"
             class="absolute top-full left-0 z-50 flex hidden w-full flex-col items-center justify-center space-y-8 bg-black/95 py-10 text-center transition-all duration-300">

            <a asp-controller="User" asp-action="UserHome" class="font-primary text-2xl tracking-wide text-white transition hover:text-primary">
                Home
            </a>

            <a asp-controller="User" asp-action="Gyms" class="font-primary text-2xl tracking-wide text-white transition hover:text-primary">
                Gyms
            </a>

            <a asp-controller="User" asp-action="Subscription" class="font-primary text-2xl tracking-wide text-white transition hover:text-primary">
                Subscriptions
            </a>

            <a asp-controller="User" asp-action="Payments" class="font-primary text-2xl tracking-wide text-white transition hover:text-primary">
                Payments
            </a>

            <a asp-controller="User" asp-action="Profile" class="font-primary text-2xl tracking-wide text-white transition hover:text-primary">
                Profile
            </a>

            <a asp-controller="User" asp-action="Contacts" class="font-primary text-2xl tracking-wide text-white transition hover:text-primary">
                Contact us
            </a>

            <a asp-controller="Home" asp-action="index"
               class="bg-primary font-primary rounded-md px-6 py-3 text-xl text-black">
                Logout
            </a>

        </div>
    </nav>

    @RenderBody()

    <footer id="footer" class="w-full bg-black/95 px-6 pt-20 pb-8 text-gray-400 lg:px-20">

        <div class="mb-16 grid grid-cols-1 gap-12 md:grid-cols-2 lg:grid-cols-3">

            <!-- ================= ABOUT ================= -->
            <div>
                <h3 class="relative mb-5 inline-block text-2xl font-semibold text-white">
                    About FitFinder
                    <span class="bg-primary mt-2 block h-[2px] w-12"></span>
                </h3>

                <p class="text-md mb-5 leading-relaxed text-gray-400/70">
                    <span class="text-primary text-xl font-semibold">Smart Gym <span class="text-white">Discovery</span></span><br>
                    Find the best gyms near you based on your location, budget, and preferences.
                </p>

                <p class="text-md mb-5 leading-relaxed text-gray-400/70">
                    <span class="text-primary text-xl font-semibold">Flexible <span class="text-white">Subscriptions</span></span><br>
                    Manage all your gym memberships easily in one place.
                </p>

                <p class="text-md leading-relaxed text-gray-400/70">
                    <span class="text-primary text-xl font-semibold">Exclusive <span class="text-white">Offers</span></span><br>
                    Enjoy discounts, free trials, and personalized deals.
                </p>
            </div>

            <!-- ================= CONTACT INFO ================= -->
            <div>
                <h3 class="relative mb-5 inline-block text-2xl font-semibold text-white">
                    Contact Us
                    <span class="bg-primary mt-2 block h-[2px] w-12"></span>
                </h3>

                <div class="space-y-4 text-sm tracking-wide text-gray-400/70">

                    <p class="flex items-center gap-2 text-xl">
                        <span class="text-primary material-symbols-outlined">location_on</span> 123 Fitness Ave, Cairo, Egypt
                    </p>

                    <p class="flex items-center gap-2 text-xl">
                        <span class="text-primary material-symbols-outlined">phone</span> +20 100 606 3107 / +20 122 345 6789
                    </p>

                    <p class="flex items-center gap-2 text-xl">
                        <span class="text-primary material-symbols-outlined">email</span> support@fitfinder.com / info@fitfinder.com
                    </p>

                </div>

                <!-- Social -->
                <div class="mt-6 flex gap-4 text-xl">

                    <!-- Facebook -->
                    <img src="../Images/001-facebook.png" alt="Facebook Icon" class="h-8 w-8">

                    <!-- LinkedIn -->
                    <img src="../Images/003-linkedin.png" alt="LinkedIn Icon" class="h-9 w-9">

                    <!-- Twitter -->
                    <img src="../Images/twitter.png" alt="Twitter Icon" class="h-9 w-9">

                    <!-- Instagram -->
                    <img src="../Images/002-instagram.png" alt="Instagram Icon" class="h-9 w-9">
                </div>
            </div>

            <!-- ================= CONTACT FORM ================= -->
            <div class="md:w-full">
                <h3 class="relative mb-5 inline-block text-2xl font-semibold text-white">
                    Get In Touch
                    <span class="bg-primary mt-2 block h-[2px] w-12"></span>
                </h3>

                <form class="space-y-4">

                    <div class="flex flex-col gap-3 sm:flex-row">
                        <input type="text" placeholder="Full Name"
                               class="w-full rounded-lg border border-white/10 bg-white/5 px-4 py-3 text-white transition outline-none focus:border-primary lg:w-1/2" />

                        <input type="email" placeholder="Email"
                               class="w-full rounded-lg border border-white/10 bg-white/5 px-4 py-3 text-white transition outline-none focus:border-primary sm:w-1/2" />
                    </div>

                    <textarea placeholder="Write your message..."
                              class="h-32 w-full resize-none rounded-lg border border-white/10 bg-white/5 px-4 py-3 text-white transition outline-none focus:border-primary"></textarea>

                    <button class="bg-primary font-primary w-full rounded-lg px-8 py-3 text-2xl font-medium text-black transition hover:opacity-90">
                        Contact Us
                    </button>

                </form>
            </div>

        </div>

        <!-- ================= BOTTOM ================= -->
        <div class="flex flex-col items-center justify-between gap-6 border-t border-white/10 pt-6 text-sm md:flex-row">

            <!-- Logo -->
            <img src="../Images/White_Logo.png" class="h-12">

            <!-- Links -->
            <ul class="flex flex-wrap justify-center gap-5 text-gray-300">
                <li><a asp-controller="User" asp-action="Index" class="transition hover:text-primary">Home</a></li>
                <li><a asp-controller="User" asp-action="Gyms" class="transition hover:text-primary">Gyms</a></li>
                <li><a asp-controller="User" asp-action="Subscription" class="transition hover:text-primary">Subscriptions</a></li>
                <li><a asp-controller="User" asp-action="Payments" class="transition hover:text-primary">Payments</a></li>
                <li><a asp-controller="User" asp-action="Profile" class="transition hover:text-primary">Profile</a></li>
                <li><a asp-controller="User" asp-action="Contacts" class="transition hover:text-primary">Contact</a></li>
            </ul>

            <!-- Copyright -->
            <p class="text-center text-gray-500">
                © 2026 FitFinder. All rights reserved.
            </p>

        </div>

    </footer>

    <a id="backToTopFixed" href="#mainBody">
        <div class="BackToTop bg-primary fixed right-5 bottom-5 cursor-pointer rounded-md p-4 text-black shadow-lg hover:bg-yellow-600">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 10l7-7m0 0l7 7m-7-7v18" />
            </svg>
        </div>
    </a>

    <script src="~/js/User/userHome.js"></script>

</body>
</html>
