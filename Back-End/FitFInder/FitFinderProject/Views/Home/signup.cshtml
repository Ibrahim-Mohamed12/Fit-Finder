@model SignUpViewModel
@{
    ViewBag.Title = "Signup Page";
    Layout = "~/Views/Shared/_RegisterLayout.cshtml";
}

<div class="flex min-h-screen flex-col bg-linear-to-br from-black/94 to-black/90 lg:flex-row">

    <!-- Left: Form Section -->
    <div class="flex flex-1 flex-col items-center justify-center p-6 lg:p-16">
        
        <a href="index.html" class="mb-8 self-start">
            <img src="~/Images/White_Logo.png" alt="Logo" class="h-10 w-auto transform cursor-pointer transition-transform duration-300 hover:scale-110">
        </a>

        <div class="w-full max-w-3xl rounded-lg bg-black/30 p-8 shadow-lg lg:p-10">
       
            <form asp-action="signup" asp-controller="Home" method="post" class="space-y-6">
                @Html.AntiForgeryToken()

                <h1 class="text-primary text-center text-4xl font-semibold sm:text-5xl">CREATE ACCOUNT</h1>

                <p class="text-center text-xl tracking-wide text-white/70 sm:text-2xl">Creating an account and starting the journey</p>

                <div asp-validation-summary="All"
                     class="border-messageBorder bg-messageBackground text-messageText rounded-md border-3 p-2">
                </div>               
                <!-- Name & Email -->
                <div class="flex flex-1 flex-col">
                    <label class="text-primary mb-2 text-2xl tracking-wide">Full Name <span class="text-sm text-red-600">*</span></label>
                    <input asp-for="Name" type="text" placeholder="Enter your full name"
                    class="font-secondary w-full rounded-sm border border-gray-500 bg-black/40 p-5 text-xl transition outline-none focus:border-primary">
                </div>
                <div class="flex flex-1 flex-col">
                    <label class="text-primary mb-2 text-2xl tracking-wide">Email <span class="text-sm text-red-600">*</span></label>
                    <input asp-for="Email" type="email" placeholder="Enter your email"
                    class="font-secondary w-full rounded-sm border border-gray-500 bg-black/40 p-5 text-xl transition outline-none focus:border-primary">
                </div>

                <!-- Password & Confirm -->
                <div class="flex flex-col gap-6 md:flex-row">
                    <div class="flex flex-1 flex-col">
                        <label class="text-primary mb-2 text-2xl tracking-wide">Password <span class="text-sm text-red-600">*</span></label>
                        <input asp-for="Password" type="password" placeholder="Enter your password"
                        class="font-secondary w-full rounded-sm border border-gray-500 bg-black/40 p-5 text-xl transition outline-none focus:border-primary">
                    </div>
                    <div class="flex flex-1 flex-col">
                        <label class="text-primary mb-2 text-2xl tracking-wide">Confirm Password <span class="text-sm text-red-600">*</span></label>
                        <input asp-for="ConfirmPassword" type="password" placeholder="Confirm your password"
                        class="font-secondary w-full rounded-sm border border-gray-500 bg-black/40 p-5 text-xl transition outline-none focus:border-primary">
                    </div>
                </div>

                <!-- Gender -->
                <div class="relative flex cursor-pointer flex-col">
                    <label class="text-primary mb-2 text-2xl tracking-wide">Gender <span class="text-sm text-red-600">*</span></label>
                    <select asp-for="Gender" asp-items="@(new SelectList(new[] { new { Value = "Male", Text = "Male" }, new { Value = "Female", Text = "Female" } }, "Value", "Text"))" id="gender"
                    class="font- font-secondary w-full appearance-none rounded-sm border border-gray-500 bg-black/40 p-5 text-xl text-white/55 transition outline-none focus:border-primary">
                    
                    </select>

                    <!-- Custom arrow -->
                    <div class="pointer-events-none absolute top-17 right-4 text-white/80">
                        <svg class="h-4 w-4" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
                        </svg>
                    </div>
                </div>
                    
                <!-- Submit Button -->
                <button type="submit"
                class="text-primary border-primary w-full transform cursor-pointer rounded-sm border bg-black py-3 text-2xl font-medium shadow-lg transition hover:bg-primary hover:scale-102 hover:text-black">
                Submit
                </button>

                <!-- Login Link -->
                <p class="text-primary text-center text-lg tracking-wide sm:text-xl">Already have an Account? <a asp-controller="Home" asp-action="login" class="text-lg text-white hover:underline sm:text-2xl"> Log in</a></p>
            </form>

        <!-- OR Divider -->
        <div class="my-6 flex items-center justify-center gap-4">
            <div class="h-px flex-1 bg-gray-500"></div>
                <span class="text-primary text-2xl tracking-wide">OR</span>
            <div class="h-px flex-1 bg-gray-500"></div>
        </div>

            <!-- Social Buttons -->
            <div class="space-y-4">
                <button class="flex w-full items-center justify-center gap-2 rounded-sm border border-gray-500 bg-black/40 px-4 py-3 text-2xl font-medium text-white/80 shadow-lg transition hover:border-primary hover:scale-102">  
                    <i class="fa-brands fa-google"></i>
                    Login with Google
                </button>

                <button class="flex w-full items-center justify-center gap-2 rounded-sm border border-gray-500 bg-black/40 px-4 py-3 text-2xl font-medium text-white/80 shadow-lg transition hover:border-primary hover:scale-102">
                    <i class="fa-brands fa-facebook"></i>
                    Login with Facebook
                </button>
            </div>
        </div>
    </div>

    <!-- Right: Image / Sidebar -->
    <div class="border-primary hidden flex-1 border-l bg-linear-to-br from-black/25 to-black/20 login:flex">
        <div class="h-full w-full bg-cover bg-center shadow-lg" style="background-image: url('../Images/Login-background.jpg');"></div>
    </div>

</div>