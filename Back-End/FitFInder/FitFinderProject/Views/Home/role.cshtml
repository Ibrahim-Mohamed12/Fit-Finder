@{
    ViewBag.Title = "Role Page";
    Layout = "~/Views/Shared/_RegisterLayout.cshtml";
}

<div class="relative flex min-h-screen flex-col md:flex-row">

    <!-- LOGO -->
    <a class="absolute top-6 left-6 z-20 md:top-10 md:left-10" asp-controller="Home" asp-action="index">
        <img src="../Images/White_Logo.png"
            class="h-10 transition-transform duration-300 hover:scale-110 md:h-12"
            alt="Logo">
    </a>

    <!-- LEFT: Gym Owner -->
    <a asp-controller="Home" asp-action="login" asp-route-role="G" class="group role2-bg relative flex flex-1 items-center justify-center">

        <div class="absolute inset-0 bg-black/70 transition group-hover:bg-black/50"></div>

        <div class="relative z-10 flex flex-col items-center gap-4 px-6 text-center">

            <h1 class="text-primary text-5xl font-bold tracking-wide transition group-hover:scale-110 md:text-7xl">
                Gym Owner
            </h1>

            <p class="max-w-md text-lg text-white/80 md:text-2xl">
                Manage members, trainers, plans, and gym settings all from one powerful dashboard system
            </p>

        </div>

    </a>

    <!-- RIGHT: Trainee -->
    <a asp-controller="Home" asp-action="login" asp-route-role="T" class="group role1-bg relative flex flex-1 items-center justify-center">

        <div class="absolute inset-0 bg-black/70 transition group-hover:bg-black/50"></div>

        <div class="relative z-10 flex flex-col items-center gap-4 px-6 text-center">

            <h1 class="text-primary text-5xl font-bold tracking-wide transition group-hover:scale-110 md:text-7xl">
                Trainee
            </h1>

            <p class="max-w-md text-lg text-white/80 md:text-2xl">
                Subscribe to a gym, track your plan progress, and manage your fitness journey with ease
            </p>

        </div>

    </a>

</div>