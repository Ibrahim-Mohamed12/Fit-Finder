@{
    ViewBag.Title = "FitFinder";
    Layout = "~/Views/Shared/_HomeLayout.cshtml";
}

<!-- Hero Section -->
<main id="mainBody" class="w-full h-screen bg-cover bg-center relative Hero-bg">
    <section class="flex justify-center lg:justify-start items-center min-h-screen bg-linear-to-br from-black/85 to-black/40 pt-40 px-6 lg:pt-20 lg:px-0">
            
        <div class="text-center lg:text-left lg:max-w-2xl max-w-xl lg:ml-20">
                
            <h1
                class="font-primary text-5xl sm:text-6xl md:text-7xl lg:text-8xl font-medium text-white">
                Ready to get fit ?
            </h1>

            <h1 class="font-primary text-5xl sm:text-6xl md:text-7xl lg:text-8xl font-medium text-primary mb-4">
                Join Us
            </h1>

            <p class="text-base sm:text-lg md:text-xl font-light text-gray-300 mb-10 tracking-wide">
                Gym workouts offer an organized method of training that improves body strength,
                builds resilience, and promotes a healthier lifestyle.
            </p>

            <a asp-controller="Home" asp-action="role" class="font-primary inline-block border border-primary text-primary text-lg sm:text-xl md:text-2xl font-medium hover:bg-primary hover:text-gray-900 py-4 px-8 rounded-sm transition shadow-lg hover:scale-105">
                Get Started
            </a>

            <!-- Stats -->
            <div class="record flex flex-col sm:flex-row items-center divide-y sm:divide-y-0 sm:divide-x divide-gray-500 mt-12">
                    
                <div class="text-center sm:pr-12 py-4 transform hover:scale-105">
                    <h2 class="font-primary text-3xl sm:text-4xl font-medium text-primary">10+</h2>
                    <p class="text-gray-300 text-base sm:text-lg">Years of Experience</p>
                </div>

                <div class="text-center sm:px-12 py-4">
                    <h2 class="font-primary text-3xl sm:text-4xl font-medium text-primary">10K+</h2>
                    <p class="text-gray-300 text-base sm:text-lg">Members Joined</p>
                </div>

                <div class="text-center sm:px-12 py-4">
                    <h2 class="font-primary text-3xl sm:text-4xl font-medium text-primary">9K+</h2>
                    <p class="text-gray-300 text-base sm:text-lg">Happy Clients</p>
                </div>

            </div>

        </div>

    </section>
</main>

<!-- Services Section -->
<section id="services" class="w-full h-fit bg-linear-to-br from-black/95 to-black/89 pt-38 pb-40">

    <h1 class="font-primary text-5xl sm:text-6xl md:text-7xl text-white font-medium text-center">
        <span class="text-primary">Our</span> Services
    </h1>

    <p class="mt-4 text-base sm:text-lg md:text-xl text-gray-300 font-light text-center max-w-3xl mx-auto">
        Helping you find the perfect gym and manage your fitness journey effortlessly
    </p>

    <div class="cards grid grid-cols-1 sm:grid-cols-1 lg:grid-cols-2 gap-6 lg:gap-10 mt-20 lg:max-w-mx-width mx-auto px-4">

        <div class="Services-Card">
            <h2 class="font-primary text-2xl sm:text-3xl text-primary font-medium mb-3 sm:mb-4">
                Gym Discovery
            </h2>
            <p class="text-gray-300 text-sm sm:text-lg">
                Explore a wide range of gyms based on your location, workout style, available equipment, or membership type to find the perfect fit for your lifestyle.
            </p>
        </div>

        <div class="Services-Card">
            <h2 class="font-primary text-2xl sm:text-3xl text-primary font-medium mb-3 sm:mb-4">
                Detailed Gym Profiles
            </h2>
            <p class="text-gray-300 text-sm sm:text-lg">
                Each gym has a dedicated profile with photos, descriptions, hours, membership plans, facilities, and available classes so you can make informed choices.
            </p>
        </div>

        <div class="Services-Card">
            <h2 class="font-primary text-2xl sm:text-3xl text-primary font-medium mb-3 sm:mb-4">
                Reviews & Ratings
            </h2>
            <p class="text-gray-300 text-sm sm:text-lg">
                Read honest feedback from other users to understand the quality, cleanliness, and overall experience before visiting any gym.
            </p>
        </div>

        <div class="Services-Card">
            <h2 class="font-primary text-2xl sm:text-3xl text-primary font-medium mb-3 sm:mb-4">
                Search & Filter
            </h2>
            <p class="text-gray-300 text-sm sm:text-lg">
                Quickly find gyms with specific features such as swimming pools, personal training, group fitness classes, or special amenities with advanced filters.
            </p>
        </div>

        <div class="Services-Card">
            <h2 class="font-primary text-2xl sm:text-3xl text-primary font-medium mb-3 sm:mb-4">
                Gym Management Dashboard
            </h2>
            <p class="text-gray-300 text-sm sm:text-lg">
                Gym owners can manage their gym details, including facilities, pricing, class schedules, and high-quality images, all from a user-friendly dashboard.
            </p>
        </div>

        <div class="Services-Card">
            <h2 class="font-primary text-2xl sm:text-3xl text-primary font-medium mb-3 sm:mb-4">
                Track User Engagement
            </h2>
            <p class="text-gray-300 text-sm sm:text-lg">
                Monitor how many users viewed your gym profile, bookmarked it, or left reviews, providing valuable insights into user interest and engagement.
            </p>
        </div>

        <div class="Services-Card">
            <h2 class="font-primary text-2xl sm:text-3xl text-primary font-medium mb-3 sm:mb-4">
                Manage Classes & Events
            </h2>
            <p class="text-gray-300 text-sm sm:text-lg">
                Schedule and manage group fitness classes, personal training sessions, or special events directly from your dashboard for easy booking and participation.
            </p>
        </div>

        <div class="Services-Card">
            <h2 class="font-primary text-2xl sm:text-3xl text-primary font-medium mb-3 sm:mb-4">
                Reports & Insights
            </h2>
            <p class="text-gray-300 text-sm sm:text-lg">
                Access analytics on your gym’s performance, including member visits, popular services, and membership growth, helping you make data-driven decisions.
            </p>
        </div>

    </div>
</section>

<!-- About Us Section -->
<section id="about" class="w-full h-fit About-bg relative">

    <div class="flex flex-col h-full bg-linear-to-br from-black/90 to-black/60 pt-38 pb-40 box-content">

        <h1 class="font-primary text-7xl text-white font-medium text-center">About<span class="text-primary"> Us</span></h1>
            
        <p class="mt-4 text-base sm:text-lg md:text-xl text-gray-300 font-light text-center max-w-3xl mx-auto">
            Helping you find the perfect gym and manage your fitness journey effortlessly
        </p>

        <div class="text-start flex lg:flex-row md:flex-col sm:flex-col items-center justify-around mt-20 w-full px-4">

            <div class="text-white 2xl:max-w-3xl max-w-2xl text-lg sm:text-xl md:text-xl font-light mb-6 p-6 rounded-sm shadow-lg text-justify divide-y divide-primary/40 sm:border-2 sm:border-primary border-2 border-primary  lg:bg-transparent">

                <p class="py-8 transition-transform duration-300 transform hover:scale-101">
                    Our platform is designed to simplify the way people discover and connect with fitness centers. We provide a modern digital solution that helps users easily find gyms that match their preferences, whether they are looking for specific facilities, training programs, locations, or membership plans.
                </p>
                <p class="py-8 transition-transform duration-300 transform hover:scale-101">
                    For fitness enthusiasts, our website makes the process of choosing the right gym faster and more convenient. Users can browse different gyms, explore detailed information about their services, compare options, and select the one that best fits their fitness goals and lifestyle.
                </p>
                <p class="py-8 transition-transform duration-400 transform hover:scale-101">
                    For gym owners, we offer powerful management tools that allow them to showcase their gyms, update their services, manage memberships, and attract new members through increased online visibility. Our platform acts as a bridge between gyms and potential members, helping fitness businesses grow while giving users a better fitness discovery experience.
                </p>

            </div>

            <div class="max-w-2xl h-fit mt-10 shadow-lg border-2 border-primary rounded-sm skew-y-2 3xl:flex hidden">

                <img src="Images/Background2.jpg" alt="About Us" class="relative bottom-10 right-10 w-full h-auto transform hover:skew-0 transition-transform duration-300 brightness-80 shadow-lg rounded-sm">
            </div>
        </div>
    </div>
        
</section>

<section id="contact" class="w-full -3xl lg:h-fit bg-linear-to-br from-black/95 to-black/89 relative pt-10 pb-20">

<div class="flex flex-col h-full pt-30 px-4 pb-20">

    <h1 class="font-primary text-7xl text-white font-medium text-center">
        Contact<span class="text-primary"> Us</span>
    </h1>

    <p class="mt-4 text-base sm:text-lg md:text-xl text-gray-300 font-light text-center max-w-3xl mx-auto">
        Helping you find the perfect gym and manage your fitness journey effortlessly
    </p>

    <!-- Form + Contact Info -->
    <div class="flex flex-col lg:flex-row justify-center items-start lg:gap-20 gap-0 mt-20 w-full max-w-mx-width mx-auto">

        <!-- Form -->
        <form action="index.html" class="Form-style w-full lg:w-1/2"> 

            <div class="flex flex-col">
                <label class="mb-2 text-2xl font-primary text-primary">Full Name</label>
                <input 
                type="text"
                placeholder="Enter your name"
                class="p-3 rounded-sm bg-black/40 border border-gray-500 focus:border-primary outline-none transition">
            </div>

            <div class="flex flex-col mt-6">
                <label class="mb-2 text-2xl font-primary text-primary">Email</label>
                <input 
                type="email"
                placeholder="Enter your email"
                class="p-3 rounded-sm bg-black/40 border border-gray-500 focus:border-primary outline-none transition">
            </div>

            <div class="flex flex-col mt-6">
                <label class="mb-2 text-2xl font-primary text-primary">Message</label>
                <textarea 
                rows="5"
                placeholder="Write your message..."
                class="p-3 rounded-sm bg-black/40 border border-gray-500 focus:border-primary outline-none transition resize-none"></textarea>
            </div>

            <div class="flex justify-center pt-6">
                <button type="submit" class="bg-black w-full text-primary px-8 py-3 border border-primary hover:bg-primary hover:text-black font-primary text-2xl rounded-sm font-medium hover:scale-102 transition shadow-lg cursor-pointer">
                    Send Message
                </button>
            </div>

        </form>

        <!-- Contact Info -->
        <div class="w-full lg:w-1/2 text-white space-y-8 flex justify-center flex-col h-150">

            <div class="border border-primary p-6 rounded-sm bg-black/40 transform hover:scale-105 transition-transform duration-300">
                <h3 class="font-primary text-3xl text-primary mb-2">Email</h3>
                <p class="text-gray-300 text-lg">contact@fitnessexplorer.com</p>
            </div>

            <div class="border border-primary p-6 rounded-sm bg-black/40 transform hover:scale-105 transition-transform duration-300">
                <h3 class="font-primary text-3xl text-primary mb-2">Phone</h3>
                <p class="text-gray-300 text-lg">+20 100 123 4567</p>
            </div>

            <div class="border border-primary p-6 rounded-sm bg-black/40 transform hover:scale-105 transition-transform duration-300">
                <h3 class="font-primary text-3xl text-primary mb-2">Location</h3>
                <p class="text-gray-300 text-lg">Cairo, Egypt</p>
            </div>
        </div>
    </div>
</div>
</section>