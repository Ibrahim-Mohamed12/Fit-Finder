@{
    ViewBag.Title = "Payments";
    Layout = "~/Views/Shared/_UserLayout.cshtml";
}

<!-- ================= ADD CARD MODAL ================= -->
<div id="addCardModal" class="fixed inset-0 bg-black/80 hidden items-center justify-center z-50">

    <div class="bg-black/95 border border-primary/30 rounded-2xl w-full max-w-md p-6 relative shadow-2xl">

        <!-- CLOSE -->
        <button id="closeAddCard"
            class="absolute top-4 right-4 text-white text-2xl hover:text-primary transition">
            &times;
        </button>

        <!-- HEADER -->
        <div class="mb-6">
            <h3 class="text-2xl text-white font-semibold">
                Add Payment Method
            </h3>
            <p class="text-gray-400 text-sm mt-1">
                Securely save your card for faster checkout
            </p>
        </div>

        <!-- FORM -->
        <div class="space-y-4">

            <!-- CARD HOLDER -->
            <div>
                <label class="text-xs text-gray-400">Card Holder Name</label>
                <input type="text"
                    placeholder="John Doe"
                    class="w-full mt-1 bg-black/70 border border-primary/40 focus:border-primary text-white px-4 py-3 rounded-lg outline-none transition"/>
            </div>

            <!-- CARD NUMBER -->
            <div>
                <label class="text-xs text-gray-400">Card Number</label>
                <div class="relative mt-1">

                    <input type="text"
                        placeholder="1234 5678 9012 3456"
                        class="w-full bg-black/70 border border-primary/40 focus:border-primary text-white px-4 py-3 rounded-lg outline-none transition pr-10"/>

                    <span class="absolute right-3 top-1/2 -translate-y-1/2 text-primary text-lg">
                        💳
                    </span>

                </div>
            </div>

            <!-- EXP + CVV -->
            <div class="flex gap-3">

                <div class="w-1/2">
                    <label class="text-xs text-gray-400">Expiry</label>
                    <input type="text"
                        placeholder="MM/YY"
                        class="w-full mt-1 bg-black/70 border border-primary/40 focus:border-primary text-white px-4 py-3 rounded-lg outline-none transition"/>
                </div>

                <div class="w-1/2">
                    <label class="text-xs text-gray-400">CVV</label>
                    <input type="password"
                        placeholder="***"
                        class="w-full mt-1 bg-black/70 border border-primary/40 focus:border-primary text-white px-4 py-3 rounded-lg outline-none transition"/>
                </div>

            </div>

            <!-- BILLING INFO -->
            <div>
                <label class="text-xs text-gray-400">Billing Address (Optional)</label>
                <input type="text"
                    placeholder="Cairo, Egypt"
                    class="w-full mt-1 bg-black/70 border border-primary/40 focus:border-primary text-white px-4 py-3 rounded-lg outline-none transition"/>
            </div>

            <!-- SAVE -->
            <button class="w-full bg-primary text-black py-3 rounded-lg font-semibold text-lg hover:opacity-90 transition mt-2">
                Save Card
            </button>

            <!-- SECURITY NOTE -->
            <p class="text-center text-xs text-gray-500 mt-2">
                🔒 Your card details are encrypted and never stored in plain text
            </p>

        </div>

    </div>

</div>

<!-- ================= PAYMENT LOG ================= -->
