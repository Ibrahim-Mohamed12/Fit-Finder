@{
    ViewBag.Title = "Contacts";
    Layout = "~/Views/Shared/_UserLayout.cshtml";
}

<!-- Hero Section -->
<main id="mainBody" class="w-full h-fit bg-cover bg-center relative User-Hero-bg">
    <section class="min-h-screen flex items-center justify-center bg-linear-to-br from-black/85 to-black/40 px-6 py-20 box-border">

        <div class="max-w-7xl w-full md:m-0 mt-20">

            <!-- Title -->
            <div class="text-center mb-12 fade-up" data-animate="title">
                <h2 class="text-4xl md:text-6xl lg:text-7xl font-bold font-primary text-white tracking-wide mb-4">
                    Contact <span class="text-primary">Us</span>
                </h2>
                <p class="text-base sm:text-lg md:text-xl font-light text-gray-300 mb-10 tracking-wide">
                    We'd love to hear from you! Reach out to us with any questions or feedback.
                </p>

            </div>

            <!-- to-bottom -->
            <a href="#footer" class="flex justify-center fade-up" data-animate="toBottom">
                <div class="toBottom text-black bg-primary p-4 rounded-md shadow-lg hover:bg-yellow-600 cursor-pointer">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
                    </svg>
                </div>
            </a>

        </div>

    </section>
</main>