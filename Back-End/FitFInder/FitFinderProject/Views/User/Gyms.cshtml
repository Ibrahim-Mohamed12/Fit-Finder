@{
    ViewBag.Title = "Gyms";
    Layout = "~/Views/Shared/_UserLayout.cshtml";
}

<!-- Gym -->
<section class="w-full py-16 text-center bg-linear-to-br from-black/95 to-black/90 pt-50">

    <div class="mb-12 text-center fade-up">

        <!-- TITLE -->
        <h2 class="text-5xl sm:text-6xl md:text-7xl font-medium font-primary text-white mb-4">
            Available <span class="text-primary">Gyms</span>
        </h2>

        <p class="text-base sm:text-lg md:text-xl font-light text-gray-300 tracking-wide mb-8">
            Explore the best gyms in your area
        </p>

        <!-- SEARCH BAR -->
        <div class="relative mb-6 fade-up w-[90%] sm:w-[80%] md:max-w-3xl mx-auto">

            <input 
                type="text" 
                placeholder="Search gyms..."
                class="w-full bg-black/70 text-base md:text-xl border border-primary/50 focus:border-primary text-white placeholder-gray-400 
                    pl-5 pr-12 py-3 md:py-5 rounded-xl outline-none transition"
            />

            <span class="absolute right-4 top-1/2 -translate-y-1/2 text-gray-400 pointer-events-none">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 md:h-6 md:w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                        d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                </svg>
            </span>

        </div>

        <!-- FILTERS -->
        <div class="flex flex-wrap justify-center gap-2 mb-10">

            <div class="flex items-center px-8 py-2 gap-2 text-md rounded-md border border-primary/70 text-gray-300 hover:bg-primary hover:text-black cursor-pointer transition">
                <span class="material-symbols-outlined cursor-pointer">check_circle</span>
                <button class="cursor-pointer">
                    Open Now
                </button>
            </div>

            <div class="flex items-center px-8 py-2 gap-2 text-md rounded-md border border-primary/70 text-gray-300 hover:bg-primary hover:text-black cursor-pointer transition">
                <span class="material-symbols-outlined cursor-pointer">star</span>
                <button class="cursor-pointer">
                    Top Rated
                </button>
            </div>

            <div class="flex items-center px-8 py-2 gap-1 text-md rounded-md border border-primary/70 text-gray-300 hover:bg-primary hover:text-black cursor-pointer transition">
                <span class="material-symbols-outlined cursor-pointer">attach_money</span>
                <button class="cursor-pointer">
                    Budget
                </button>
            </div>

            <div class="flex items-center px-8 py-2 gap-2 text-md rounded-md border border-primary/70 text-gray-300 hover:bg-primary hover:text-black cursor-pointer transition">
                <span class="material-symbols-outlined cursor-pointer">location_on</span>
                <button class="cursor-pointer">
                    Near Me
                </button>
            </div>

        </div>

    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-8 px-6 lg:px-20">

        <!-- Gym Card -->
        <div class="group rounded-2xl overflow-hidden bg-black/80 border border-primary/30 hover:border-primary transition duration-300 hover:-translate-y-2 fade-up">

            <!-- IMAGE -->
            <div class="relative">
                <img src="../Images/Background2.jpg"
                    class="w-full h-auto object-cover group-hover:scale-105 transition duration-300"
                    alt="Gym">

                <!-- Rating -->
                <div class="absolute top-3 right-3 bg-black/70 text-yellow-400 text-sm px-3 py-1 rounded-full">
                    ★ 4.8 <span class="text-gray-300 text-xs">(1.2k)</span>
                </div>

                <!-- Open status -->
                <div class="absolute top-3 left-3 bg-green-500/20 text-green-400 text-xs px-3 py-1 rounded-full">
                    Open Now
                </div>
            </div>

            <div class="p-5 text-left">

                <!-- TITLE -->
                <div class="flex justify-between items-start">
                    <h3 class="text-xl font-semibold text-white">FitLife Gym</h3>
                    <span class="text-primary text-sm font-medium">$25/mo</span>
                </div>

                <!-- LOCATION + DISTANCE -->
                <p class="text-gray-400 text-sm mt-1">
                    Downtown • 1.2 km away
                </p>

                <!-- QUICK STATS -->
                <div class="flex gap-2 flex-wrap mt-3">
                    <span class="text-xs bg-white/5 text-gray-300 px-2 py-1 rounded-full">24/7 Access</span>
                    <span class="text-xs bg-white/5 text-gray-300 px-2 py-1 rounded-full">PT Available</span>
                    <span class="text-xs bg-white/5 text-gray-300 px-2 py-1 rounded-full">Beginner Friendly</span>
                </div>

                <!-- DESCRIPTION -->
                <p class="text-gray-400 text-sm mt-4 leading-relaxed">
                    Modern fitness center with premium equipment, certified trainers, and flexible training programs.
                </p>

                <!-- FEATURES (DECISION DRIVERS) -->
                <div class="flex flex-wrap gap-2 mt-4">
                    <span class="text-xs bg-primary/10 text-primary px-2 py-1 rounded-full">Free Trial</span>
                    <span class="text-xs bg-primary/10 text-primary px-2 py-1 rounded-full">Group Classes</span>
                    <span class="text-xs bg-primary/10 text-primary px-2 py-1 rounded-full">Nutrition Plans</span>
                </div>

                <!-- CTA -->
                <div class="flex gap-3 mt-5">

                    <button class="flex-1 bg-primary text-black py-2 rounded-lg text-sm font-semibold hover:opacity-90 transition">
                        View Details
                    </button>

                    <button class="flex-1 border border-primary text-primary py-2 rounded-lg text-sm font-semibold hover:bg-primary/10 transition">
                        Book Trial
                    </button>

                </div>

            </div>
        </div>

