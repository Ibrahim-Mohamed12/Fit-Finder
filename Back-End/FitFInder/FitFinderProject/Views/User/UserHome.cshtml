<!-- Featured Offer -->
<section class="w-full py-16 bg-linear-to-br from-black/95 to-black/90 px-6 lg:px-20">

    <div class="max-w-7xl mx-auto py-20">

        <!-- HEADER -->
        <div class="text-center mb-12 fade-up">
            <h2 class="text-4xl sm:text-5xl md:text-6xl font-primary text-white mb-4">
                Smart <span class="text-primary">Offers</span>
            </h2>
            <p class="text-gray-400 text-lg">
                We picked the best option for you based on popularity & value
            </p>
        </div>

            <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">

            <!-- 🥈 BUDGET -->
            <div class="rounded-2xl overflow-hidden border border-primary/30 bg-black/80 p-6 opacity-90 hover:opacity-100 transition fade-up">

                <span class="text-green-400 text-xs">Budget Friendly</span>

                <h3 class="text-xl font-semibold text-white mt-2 mb-2">
                    Free 7-Day Trial
                </h3>

                <p class="text-gray-400 text-sm mb-4">
                    Try gyms near you with zero commitment.
                </p>

                <div class="flex flex-wrap gap-2 mb-6">
                    <span class="text-xs bg-white/5 text-gray-300 px-2 py-1 rounded-full">No Payment</span>
                    <span class="text-xs bg-white/5 text-gray-300 px-2 py-1 rounded-full">Risk Free</span>
                </div>

                <button class="w-full border border-primary text-primary py-2 rounded-lg hover:bg-primary/10 transition">
                    Select Trial
                </button>

            </div>

            <!-- 🥇 RECOMMENDED (HIGHLIGHTED) -->
            <div class="relative rounded-2xl overflow-hidden border-2 border-primary bg-black/90 shadow-lg scale-[1.02] fade-up">

                <!-- badge -->
                <div class="absolute top-4 left-4 bg-primary text-black text-xs font-bold px-3 py-1 rounded-full z-10">
                    Recommended
                </div>

                <div class="p-6">

                    <h3 class="text-2xl font-semibold text-white mt-6 mb-2">
                        50% Off First Month + Free PT
                    </h3>

                    <p class="text-gray-400 text-sm mb-4">
                        Best value for beginners starting their fitness journey.
                    </p>

                    <div class="text-sm text-white mb-2">
                        <span class="text-gray-400">You pay:</span> <span class="text-primary font-bold">$25</span>
                    </div>

                    <div class="flex flex-wrap gap-2 mb-6">
                        <span class="text-xs bg-primary/10 text-primary px-2 py-1 rounded-full">Most Popular</span>
                        <span class="text-xs bg-primary/10 text-primary px-2 py-1 rounded-full">Free Trial</span>
                    </div>

                    <button class="w-full bg-primary text-black py-3 rounded-lg font-semibold hover:opacity-90 transition">
                        Choose Recommended
                    </button>

                </div>
            </div>

            <!-- 🥉 PREMIUM -->
            <div class="rounded-2xl overflow-hidden border border-primary/30 bg-black/80 p-6 opacity-90 hover:opacity-100 transition fade-up">

                <span class="text-yellow-400 text-xs">Premium Choice</span>

                <h3 class="text-xl font-semibold text-white mt-2 mb-2">
                    20% Off Annual Plan
                </h3>

                <p class="text-gray-400 text-sm mb-4">
