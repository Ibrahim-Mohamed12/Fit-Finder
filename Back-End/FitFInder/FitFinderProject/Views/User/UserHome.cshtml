@{
    ViewBag.Title = "Homepage";
    Layout = "~/Views/Shared/_UserLayout.cshtml";
}

<!-- Hero Section -->
<main id="mainBody" class="w-full h-fit bg-cover bg-center relative User-Hero-bg">
    <section class="min-h-screen flex items-center justify-center bg-linear-to-br from-black/85 to-black/40 px-6 py-20 box-border">

        <div class="max-w-7xl w-full md:m-0 mt-20">

            <!-- Title -->
            <div class="text-center mb-12 fade-up" data-animate="title">
                <h2 class="text-3xl lg:text-6xl font-bold font-primary text-primary tracking-wide mb-4">
                    How It Works
                </h2>
                <p class="text-base sm:text-lg md:text-xl font-light text-gray-300 mb-10 tracking-wide">
                    Get started in just 3 simple steps
                </p>
            </div>

            <!-- Cards -->
            <div class="grid grid-cols-1 md:grid-cols-1 lg:grid-cols-3 gap-6">

                <!-- Card 1 -->
                <div class="group p-8 rounded-2xl bg-black/80 border border-primary/50 hover:border-primary transition duration-300 hover:-translate-y-2 text-center fade-up">

                    <div class="w-12 h-12 mx-auto flex items-center justify-center rounded-full bg-amber-400 text-black font-bold text-xl mb-4">
                        1
                    </div>

                    <h3 class="text-2xl font-semibold text-white mb-2">
                        Find Your Gym
                    </h3>

                    <p class="text-base sm:text-lg md:text-xl font-light text-gray-300 tracking-wide">
                        Browse and explore gyms near you with ease.
                    </p>

                </div>

                <!-- Card 2 -->
                <div class="group p-8 rounded-2xl bg-black/80 border border-primary/50 hover:border-primary transition duration-300 hover:-translate-y-2 text-center fade-up">

                    <div class="w-12 h-12 mx-auto flex items-center justify-center rounded-full bg-amber-400 text-black font-bold text-xl mb-4">
                        2
                    </div>

                    <h3 class="text-2xl font-semibold text-white mb-2">
                        Choose a Plan
                    </h3>

                    <p class="text-base sm:text-lg md:text-xl font-light text-gray-300 tracking-wide">
                        Select a membership that matches your goals.
                    </p>

                </div>

                <!-- Card 3 -->
                <div class="group p-8 rounded-2xl bg-black/80 border border-primary/50 hover:border-primary transition duration-300 hover:-translate-y-2 text-center fade-up">

                    <div class="w-12 h-12 mx-auto flex items-center justify-center rounded-full bg-amber-400 text-black font-bold text-xl mb-4">
                        3
                    </div>

                    <h3 class="text-2xl font-semibold text-white mb-2">
                        Start Training
                    </h3>

                    <p class="text-base sm:text-lg md:text-xl font-light text-gray-300 tracking-wide">
                        Begin your fitness journey and stay consistent.
                    </p>

                </div>

            </div>

        </div>

    </section>
</main>

